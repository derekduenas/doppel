# DOPPEL paper runtime for one sealed genome (instance = genome name). FILE ONLY: not installed.
# The lead installs it through ops/deploy.sh after review. Paper only: the unit has no network at
# all (no address family, private network namespace), no credentials, no market-data group and no
# view of the credential directories, so it cannot reach any venue even by mistake. It reads the tape
# and the BRTI relay's output read-only and writes only its own journal directory.
#   genome:  /mnt/volume_nyc1_1793485122853/doppel/paper/%i/genome.json  (copy of the sealed genome)
#   journal: /mnt/volume_nyc1_1793485122853/doppel/paper/%i/              (journal-*.jsonl, checkpoints/)
#   halt:    touch .../paper/%i/KILL (this genome) or .../paper/KILL (every paper run)
# --opening must be the genome's bound protocol rule (the runtime checks registry/genomes.jsonl and
# refuses otherwise): received_raw for H1-H4. First start needs --from-now once (a new journal):
#   systemctl edit doppel-paper@NAME   (add --from-now for the very first start only)
# Raw BRTI comes from doppel-brti-relay's output (PERELMAN's own directory is private to its user).
[Unit]
Description=DOPPEL paper runtime (genome %i) on the live tape, no orders
After=doppel-tape.service

[Service]
Type=simple
User=doppel
WorkingDirectory=/opt/doppel
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/doppel/.venv/bin/doppel-paper run \
  --genome /mnt/volume_nyc1_1793485122853/doppel/paper/%i/genome.json \
  --data /mnt/volume_nyc1_1793485122853/doppel/tape \
  --journal /mnt/volume_nyc1_1793485122853/doppel/paper/%i \
  --opening received_raw \
  --registry /opt/doppel \
  --perelman /mnt/volume_nyc1_1793485122853/doppel/perelman-relay \
  --kill-file /mnt/volume_nyc1_1793485122853/doppel/paper/%i/KILL \
  --kill-file /mnt/volume_nyc1_1793485122853/doppel/paper/KILL
# An invalid or unbound-mismatched genome (2), a journal that fails recovery, or a tape failure (3)
# must not restart-loop. A halted run with every window settled exits 0 and stays down.
Restart=on-failure
RestartPreventExitStatus=2 3
RestartSec=10
CPUQuota=50%
MemoryHigh=512M
MemoryMax=1G
Nice=10
NoNewPrivileges=true
PrivateNetwork=true
RestrictAddressFamilies=none
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
InaccessiblePaths=-/etc/edge-engine -/etc/atlas -/etc/doppel -/etc/credstore.encrypted
ReadOnlyPaths=/mnt/volume_nyc1_1793485122853/doppel/tape
ReadOnlyPaths=/mnt/volume_nyc1_1793485122853/doppel/perelman-relay
ReadWritePaths=/mnt/volume_nyc1_1793485122853/doppel/paper/%i

[Install]
WantedBy=multi-user.target
