[Unit]
Description=DOPPEL local retention verified against canonical R2 archive
Wants=network-online.target
After=network-online.target doppel-storage.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/doppel/ops/tape_janitor.py --storage-policy /opt/doppel-storage/storage-policy.toml --storage-audit /var/tmp/doppel-storage-audit.json --max-files 12
Nice=19
IOSchedulingClass=idle
MemoryMax=384M
OOMScoreAdjust=800
TimeoutStartSec=12min
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/mnt/volume_nyc1_1793485122853/doppel
