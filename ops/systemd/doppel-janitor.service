[Unit]
Description=DOPPEL tape janitor (free-space floor)

[Service]
Type=oneshot
User=doppel
# The Rust shadow tape is a duplicate: prune it first ("-": its "nothing deletable" must not skip the
# main tape). Audit A4-F2: the shadow was never pruned and silently ate the main tape's retention.
ExecStart=-/opt/doppel/ops/doppel-janitor.sh /mnt/volume_nyc1_1793485122853/doppel/tape-rust 12
ExecStart=/opt/doppel/ops/doppel-janitor.sh /mnt/volume_nyc1_1793485122853/doppel/tape 12
