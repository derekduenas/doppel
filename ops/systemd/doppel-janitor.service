[Unit]
Description=Prune expired DOPPEL tape with verified cold copies
Wants=network-online.target
After=network-online.target doppel-archive.service

[Service]
Type=oneshot
User=doppel
EnvironmentFile=/etc/doppel-archive.env
LoadCredential=rclone.conf:/etc/doppel/rclone.conf
Environment=RCLONE_CONFIG=%d/rclone.conf
StateDirectory=doppel-cold
StateDirectoryMode=0700
ExecStart=/bin/sh /opt/doppel/ops/doppel-cold-tape.sh prune
Nice=15
CPUWeight=10
IOWeight=10
IOSchedulingClass=idle
MemoryMax=384M
TimeoutStartSec=15min
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
